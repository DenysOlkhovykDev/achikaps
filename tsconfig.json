{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@aircraft/*": ["./src/aircraft/*"],
      "@dashboard/*": ["./src/dashboard/*"],
      "@resources/*": ["./src/resources/*"],
      "@workers/*": ["./src/workers/*"],
      "@pause/*": ["./src/ui/pause/*"],
      "@speed/*": ["./src/ui/speed/*"],
      "@joystick/*": ["./src/ui/joystick/*"],
      "@construction/*": ["./src/ui/construction/*"],
      "@roads/*": ["./src/roads/*"],
      "@utils/*": ["./src/utils/*"],
      "@test-situations/*": ["./src/test-situations/*"],
    }
  }
}