{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "paths": {
      "@buildings/*": ["./src/buildings/*"],
      "@dashboard/*": ["./src/dashboard/*"],
      "@resources/*": ["./src/resources/*"],
      "@workers/*": ["./src/workers/*"],
      "@menus/*": ["./src/menus/*"],
      "@roads/*": ["./src/roads/*"],
      "@utils/*": ["./src/utils/*"],
    }
  }
}